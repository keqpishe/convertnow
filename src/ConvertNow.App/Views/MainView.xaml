<UserControl
    x:Class="ConvertNow.App.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ConvertNow.App.Converters"
    xmlns:core="using:ConvertNow.Core">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:StateToVisibilityConverter x:Key="StateToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Padding="20,16,20,20" VerticalAlignment="Top">

        <!-- State 1 & 1b: Format Selection -->
        <StackPanel
            Spacing="12"
            Visibility="{x:Bind ViewModel.State, Mode=OneWay, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=FormatSelection}">

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE8A5;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.InputFileName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.InputFilePath, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.InputFileSizeText, Mode=OneWay}" />
            </Grid>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Convert to:" />
                <ComboBox
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.AvailableFormats, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedTargetFormat, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="core:MediaFormat">
                            <TextBlock Text="{x:Bind DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <ToggleSwitch
                Margin="0,-2,0,0"
                IsOn="{x:Bind ViewModel.UseCustomOutputDirectory, Mode=TwoWay}"
                MinWidth="0"
                OffContent="Custom save location"
                OnContent="Custom save location" />

            <Grid
                ColumnSpacing="8"
                Visibility="{x:Bind ViewModel.IsCustomPathInputVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.CustomOutputDirectory, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.CustomOutputDirectory, Mode=OneWay}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.BrowseOutputFolderCommand}"
                    Content="Browse..." />
            </Grid>

            <Border
                Padding="10,8"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{x:Bind ViewModel.ShowDiskWarning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Margin="0,2,0,0"
                        VerticalAlignment="Top"
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE7BA;" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="12"
                        Text="{x:Bind ViewModel.DiskWarningMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Button
                Margin="0,4,0,0"
                MinWidth="128"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.ConvertCommand}"
                Content="Convert"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <!-- State 2: Converting -->
        <StackPanel
            Spacing="12"
            Visibility="{x:Bind ViewModel.State, Mode=OneWay, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=Converting}">

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE8A5;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.ConversionPairText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.TargetOutputPath, Mode=OneWay}" />
            </Grid>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock
                FontWeight="Medium"
                Text="{x:Bind ViewModel.ConvertingStatusText, Mode=OneWay}" />

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                    Maximum="100"
                    Minimum="0"
                    Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    MinWidth="38"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.ProgressPercentageText, Mode=OneWay}"
                    TextAlignment="Right" />
            </Grid>

            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EtaText, Mode=OneWay}" />

            <Button
                Margin="0,6,0,0"
                MinWidth="128"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="Cancel" />
        </StackPanel>

        <!-- State 3: Completed -->
        <StackPanel
            Spacing="12"
            Visibility="{x:Bind ViewModel.State, Mode=OneWay, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=Completed}">

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE73E;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Done!" />
            </Grid>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.CompletedOutputSummary, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="2"
                Text="{x:Bind ViewModel.CompletedDirectoryText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                ToolTipService.ToolTip="{x:Bind ViewModel.CompletedOutputPath, Mode=OneWay}" />

            <StackPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    MinWidth="128"
                    Command="{x:Bind ViewModel.OpenFolderCommand}"
                    Content="Open folder"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    MinWidth="128"
                    Command="{x:Bind ViewModel.CloseCommand}"
                    Content="Close" />
            </StackPanel>
        </StackPanel>

        <!-- State 4: Error -->
        <StackPanel
            Spacing="12"
            Visibility="{x:Bind ViewModel.State, Mode=OneWay, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=Error}">

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="&#xEA39;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Conversion failed" />
            </Grid>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                <TextBlock
                    Text="{x:Bind ViewModel.ErrorDisplayText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </ScrollViewer>

            <StackPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    MinWidth="128"
                    Command="{x:Bind ViewModel.RetryCommand}"
                    Content="Retry"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    MinWidth="128"
                    Command="{x:Bind ViewModel.CloseCommand}"
                    Content="Close" />
            </StackPanel>
        </StackPanel>

        <!-- State 5: Unsupported Format -->
        <StackPanel
            Spacing="12"
            Visibility="{x:Bind ViewModel.State, Mode=OneWay, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=Unsupported}">

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="&#xE7BA;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Unsupported format" />
            </Grid>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock
                Text="{x:Bind ViewModel.UnsupportedMessage, Mode=OneWay}"
                TextWrapping="Wrap" />

            <Button
                Margin="0,8,0,0"
                MinWidth="128"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.CloseCommand}"
                Content="Close" />
        </StackPanel>

        <!-- State 6: No File Fallback -->
        <StackPanel
            Spacing="12"
            Visibility="{x:Bind ViewModel.State, Mode=OneWay, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=NoFile}">

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE8A5;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Convert.Now" />
            </Grid>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock
                Text="Select a video, audio, or image file to convert."
                TextWrapping="Wrap" />

            <StackPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    MinWidth="128"
                    Command="{x:Bind ViewModel.BrowseInputFileCommand}"
                    Content="Browse file..."
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    MinWidth="128"
                    Command="{x:Bind ViewModel.CloseCommand}"
                    Content="Close" />
            </StackPanel>
        </StackPanel>

    </Grid>
</UserControl>
